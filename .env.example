# Copy to .env. Values here are read at startup; real environment variables
# win over the file. Secrets (DB_URL, JWT_SECRET, SMTP_*) have no defaults in
# code: the server refuses to start without them.

# Server
PORT=8081
APP_ENV=local
# Interface to listen on. Leave at 127.0.0.1 outside Docker; the image sets 0.0.0.0.
BIND_ADDR=127.0.0.1

# OpenTelemetry (traces, metrics, logs over OTLP/HTTP). Leave the endpoint
# empty to disable export entirely. `docker compose up` sets it to the local
# SigNoz collector; the deploy sets it to the one on the VPS. For SigNoz Cloud
# also set OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<key>.
OTEL_SERVICE_NAME=portfolio-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Database. These credentials match the `db` service in compose.yaml.
DB_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable

# Migrations
MIGRATIONS_PATH=db/migrations

# Local seeds
SEEDS_PATH=db/seeds
SEED_ENABLED=true

# JWT. Required, at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_ISSUER=NinjaShadowBoy-PortfolioApp

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:*

# Contact email notifications. SMTP_USERNAME, SMTP_PASSWORD and
# EMAIL_RECIPIENT are required when EMAIL_SENDING_ENABLED=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_RECIPIENT=
EMAIL_SENDING_ENABLED=false

# OAuth2 -  full walkthrough (URL hops, provider setup, device flow) in OAUTH_SETUP.md.
# OAUTH2_REDIRECT_URI: FRONTEND page the backend sends the browser to after login.
# OAUTH_BASE_URL:      BACKEND public base URL the provider redirects back to;
#                      callbacks are <OAUTH_BASE_URL>/auth/<provider>/callback and
#                      must match each provider console exactly (keep the /portfolio/v1).
OAUTH2_REDIRECT_URI=http://localhost:4200/oauth2/redirect
OAUTH_BASE_URL=http://localhost:8081/portfolio/v1

# Google -  https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub -  https://github.com/settings/developers (OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
