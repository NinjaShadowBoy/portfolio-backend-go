# Server
PORT=8080
APP_ENV=local

# Database
DB_URL=postgres://postgres:password@localhost:5432/portfolio?sslmode=disable

# Migrations
MIGRATIONS_PATH=db/migrations

# Local seeds
SEEDS_PATH=db/seeds
SEED_ENABLED=true

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000
JWT_ISSUER=NinjaShadowBoy-PortfolioApp

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:*,https://ninjashadowboy.github.io,https://alexabena.me,https://alexabena.space

# Contact email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username@gmail.com
SMTP_PASSWORD=your-smtp-app-password
EMAIL_RECIPIENT=your-recipient@example.com
EMAIL_SENDING_ENABLED=false

# OAuth2 -  full walkthrough (URL hops, provider setup, device flow) in OAUTH_SETUP.md.
# OAUTH2_REDIRECT_URI: FRONTEND page the backend sends the browser to after login.
# OAUTH_BASE_URL:      BACKEND public base URL the provider redirects back to;
#                      callbacks are <OAUTH_BASE_URL>/auth/<provider>/callback and
#                      must match each provider console exactly (keep the /portfolio/v1).
OAUTH2_REDIRECT_URI=http://localhost:4200/oauth2/redirect
OAUTH_BASE_URL=http://localhost:8080/portfolio/v1

# Google -  https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub -  https://github.com/settings/developers (OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
