# Server
PORT=8080
APP_ENV=local

# Database
DB_URL=postgres://postgres:password@localhost:5432/portfolio?sslmode=disable

# Migrations
MIGRATIONS_PATH=db/migrations

# Local seeds
SEEDS_PATH=db/seeds
SEED_ENABLED=true

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000
JWT_ISSUER=NinjaShadowBoy-PortfolioApp

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:*,https://ninjashadowboy.github.io,https://alexabena.me

# Contact email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username@gmail.com
SMTP_PASSWORD=your-smtp-app-password
EMAIL_RECIPIENT=your-recipient@example.com
EMAIL_SENDING_ENABLED=false

# OAuth2
#
# Two different URLs for two different hops — do not mix them up:
#
# OAUTH2_REDIRECT_URI = the FRONTEND page the backend forwards the browser to
#   AFTER login finishes. It receives ?token=<jwt> on success or ?error=<msg> on
#   failure. It is a UI route (not versioned), so it stays on the Angular host.
OAUTH2_REDIRECT_URI=http://localhost:4200/oauth2/redirect
#
# OAUTH_BASE_URL = the BACKEND's public base URL that the provider redirects back
#   to. The provider callback URLs are derived from it (<OAUTH_BASE_URL>/auth/<p>/callback),
#   so it must be reachable by the browser and match what you register in each
#   provider's console EXACTLY. It includes the versioned API base path (/portfolio/v1).
OAUTH_BASE_URL=http://localhost:8080/portfolio/v1

# Google — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register: <OAUTH_BASE_URL>/auth/google/callback
#   e.g. http://localhost:8080/portfolio/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers (OAuth Apps)
# Authorization callback URL to register: <OAUTH_BASE_URL>/auth/github/callback
#   e.g. http://localhost:8080/portfolio/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
