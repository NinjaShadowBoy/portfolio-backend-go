# Copy to .env. Values here are read at startup; real environment variables
# win over the file. Secrets (DB_URL, JWT_SECRET, SMTP_*) have no defaults in
# code: the server refuses to start without them.

# Server
PORT=8081
APP_ENV=local
# Interface to listen on. Leave at 127.0.0.1 outside Docker; the image sets 0.0.0.0.
BIND_ADDR=127.0.0.1

# OpenTelemetry (traces, metrics, logs over OTLP/HTTP). Leave the endpoint
# empty to disable export entirely. `docker compose up` sets it to the local
# SigNoz collector; the deploy sets it to the one on the VPS. For SigNoz Cloud
# also set OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<key>.
OTEL_SERVICE_NAME=portfolio-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Database. These credentials match the `db` service in compose.yaml.
DB_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable

# Migrations
MIGRATIONS_PATH=db/migrations

# Local seeds
SEEDS_PATH=db/seeds
SEED_ENABLED=true

# JWT. Required, at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_ISSUER=NinjaShadowBoy-PortfolioApp

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:*

# Contact email notifications. SMTP_USERNAME, SMTP_PASSWORD and
# EMAIL_RECIPIENT are required when EMAIL_SENDING_ENABLED=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_RECIPIENT=
EMAIL_SENDING_ENABLED=false

# OAuth2 -  full walkthrough (URL hops, provider setup, device flow) in OAUTH_SETUP.md.
# OAUTH2_REDIRECT_URI: FRONTEND page the backend sends the browser to after login.
# OAUTH_BASE_URL:      BACKEND public base URL the provider redirects back to;
#                      callbacks are <OAUTH_BASE_URL>/auth/<provider>/callback and
#                      must match each provider console exactly (keep the /portfolio/v1).
OAUTH2_REDIRECT_URI=http://localhost:4200/oauth2/redirect
OAUTH_BASE_URL=http://localhost:8081/portfolio/v1

# Google -  https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub -  https://github.com/settings/developers (OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Knowledge index for the site assistant. It embeds through OpenRouter with
# OPENROUTER_API_KEY (below), so it runs exactly when the chat does: with
# CHAT_ENABLED=false nothing is embedded. The API indexes KNOWLEDGE_DIR and the
# projects at startup (in the background) and every KNOWLEDGE_SYNC_INTERVAL.
# The models are OpenRouter ids; changing EMBEDDING_DOC_MODEL re-embeds
# everything. See knowledge/README.md.
EMBEDDING_DOC_MODEL=mongodb/voyage-4-large
EMBEDDING_QUERY_MODEL=mongodb/voyage-4-lite
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_SYNC_INTERVAL=10m

# Site assistant (OpenRouter). Off by default: CHAT_ENABLED=false means nothing
# calls OpenRouter, and OPENROUTER_API_KEY is required only when it is true.
# CHAT_MODEL defaults to the free models router, so local runs cost nothing;
# production uses anthropic/claude-haiku-5.5. CHAT_PROVIDER_SORT orders
# providers by price, throughput or latency (empty: OpenRouter's default
# routing) and require_parameters is always on, because the assistant needs
# tool support. CHAT_DATA_COLLECTION is allow or deny; many free models need
# allow; it applies to embedding requests too. CHAT_REASONING is default, off, low, medium or high. default sends no
# reasoning field, so the free router can still pick any free model; production
# sets off to stop Haiku 5.5 thinking. An Anthropic effort needs max_tokens
# above its 1024-token minimum, more than the 800-token answer budget.
# The daily message caps are per subject per UTC day; the token budget is the
# global spend knob, and the assistant rests for everyone when it trips.
CHAT_ENABLED=false
OPENROUTER_API_KEY=
CHAT_MODEL=openrouter/free
CHAT_PROVIDER_SORT=
CHAT_DATA_COLLECTION=allow
CHAT_REASONING=default
CHAT_DAILY_MESSAGES_ANON=30
CHAT_DAILY_MESSAGES_USER=100
CHAT_DAILY_TOKEN_BUDGET=2000000
CHAT_MAX_CONCURRENT=4

# Proxies whose X-Real-IP header gives the client IP. Empty trusts none, so
# ClientIP is the TCP peer; behind nginx set 172.16.0.0/12.
TRUSTED_PROXIES=
