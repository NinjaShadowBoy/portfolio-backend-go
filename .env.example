# Server
PORT=8080
APP_ENV=local

# Database
DB_URL=postgres://postgres:password@localhost:5432/portfolio?sslmode=disable

# Migrations
MIGRATIONS_PATH=db/migrations

# Local seeds
SEEDS_PATH=db/seeds
SEED_ENABLED=true

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000
JWT_ISSUER=NinjaShadowBoy-PortfolioApp

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:*,https://ninjashadowboy.github.io,https://alexabena.me

# Contact email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username@gmail.com
SMTP_PASSWORD=your-smtp-app-password
EMAIL_RECIPIENT=your-recipient@example.com
EMAIL_SENDING_ENABLED=false

# OAuth2
OAUTH2_REDIRECT_URI=http://localhost:4200/oauth2/redirect
OAUTH_BASE_URL=http://localhost:8080/portfolio
# Google OAuth2 callback: <OAUTH_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth2 callback: <OAUTH_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
