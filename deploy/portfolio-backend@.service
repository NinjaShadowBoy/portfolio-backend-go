# Templated systemd --user unit for the portfolio backend. %i is the
# environment (production | staging). Not installed directly - bootstrap.sh
# substitutes __APP_PATH__ for the real APP_PATH and writes the rendered
# file to ~/.config/systemd/user/. Re-run bootstrap.sh (or redo the
# substitution by hand) if this template changes; CI never touches it.
[Unit]
Description=Portfolio backend API (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__APP_PATH__/%i/current
EnvironmentFile=__APP_PATH__/%i/.env
ExecStart=__APP_PATH__/%i/current/portfolio-backend
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
